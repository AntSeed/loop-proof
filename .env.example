BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# Optional fallback for blocks outside BASE_RPC_URL's eth_getProof index range.
# Used only after the primary RPC cannot serve a state-witness request.
BASE_ARCHIVE_RPC_URL=https://YOUR_BASE_ARCHIVE_ENDPOINT
L1_RPC_URL=https://ethereum-rpc.publicnode.com
BEACON_API_URL=https://ethereum-beacon-api.publicnode.com

# Succinct Prover Network. Keep this key funded with PROVE before production proving.
# SP1_PROVER=network
# NETWORK_PRIVATE_KEY=0xYOUR_SECP256K1_PRIVATE_KEY
# NETWORK_RPC_URL=https://rpc.mainnet.succinct.xyz
# Required hard ceilings for every network proof request. These example values approve at most
# 0.32/0.48 PROVE compressed/Groth16 base fees and 0.70 PROVE per billion PGU.
# Update only through the cost approval flow.
# SP1_NETWORK_MAX_COMPRESSED_BASE_FEE_PROVE_WEI=320000000000000000
# SP1_NETWORK_MAX_GROTH16_BASE_FEE_PROVE_WEI=480000000000000000
# SP1_NETWORK_MAX_PRICE_PER_PGU_PROVE_WEI=700000000
# Readiness gate for the complete initial batch (300 PROVE recommended below).
# SP1_NETWORK_REQUIRED_BALANCE_PROVE_WEI=300000000000000000000
